# ==========================================
# DEV-TRACE AI Engine Environment Variables
# ==========================================

# 1. OpenRouter (Recommended: Access to Claude 3.5 Sonnet, Gemini 2.0 Flash, Llama 3.3, etc.)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional model override (defaults to google/gemini-2.0-flash-001)
# Popular choices:
# - anthropic/claude-3.5-sonnet
# - google/gemini-2.0-flash-001
# - meta-llama/llama-3.3-70b-instruct
# - openai/gpt-4o-mini
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# 2. Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# 3. OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Note: If no API keys are supplied, DEV-TRACE automatically runs in Zero-Config
# Intelligent Mode with its built-in rule-based and template heuristics engine.
